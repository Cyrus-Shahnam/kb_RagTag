
#BEGIN_HEADER
from kb_ragtag.ragtag_utils import RagTagRunner
#END_HEADER


class kb_ragtag:
    '''
    Module Name:
    kb_ragtag

    Module Description:
    Reference-guided genome assembly scaffolding and improvement with RagTag.
    Provides four apps: correct, scaffold, patch, and merge.
    '''

    ######## WARNING FOR GEVENT USERS ####### noqa
    # Don't run any other code in this module before you make sure all calls
    # to other services are added to this module's __init__ method.

    VERSION = "0.0.1"
    GIT_URL = ""
    GIT_COMMIT_HASH = ""

    #BEGIN_CLASS_HEADER
    #END_CLASS_HEADER

    def __init__(self, config):
        #BEGIN_CONSTRUCTOR
        self.config = config
        #END_CONSTRUCTOR
        pass

    def run_ragtag_correct(self, ctx, params):
        """
        :param params: instance of type "CorrectParams"
        :returns: instance of type "RagTagResults"
        """
        # ctx is the context object
        # return variables are: output
        #BEGIN run_ragtag_correct
        output = RagTagRunner(self.config).correct(params)
        #END run_ragtag_correct

        if not isinstance(output, dict):
            raise ValueError('Method run_ragtag_correct return value ' +
                             'output is not type dict as required.')
        return [output]

