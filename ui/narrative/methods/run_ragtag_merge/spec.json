{
    "ver": "0.0.1",
    "authors": ["ac.shahnam"],
    "contact": "https://www.kbase.us/support/",
    "categories": ["active", "assembly"],
    "widgets": {"input": null, "output": "no-display"},
    "parameters": [
        {
            "id": "query_assembly_ref",
            "optional": false, "advanced": false, "allow_multiple": false,
            "default_values": [""], "field_type": "text",
            "text_options": {"valid_ws_types": ["KBaseGenomeAnnotations.Assembly"]}
        },
        {
            "id": "reference_assembly_refs",
            "optional": false, "advanced": false, "allow_multiple": true,
            "default_values": [""], "field_type": "text",
            "text_options": {"valid_ws_types": ["KBaseGenomeAnnotations.Assembly"]}
        },
        {
            "id": "output_assembly_name",
            "optional": false, "advanced": false, "allow_multiple": false,
            "default_values": [""], "field_type": "text",
            "text_options": {
                "valid_ws_types": ["KBaseGenomeAnnotations.Assembly"],
                "is_output_name": true
            }
        },
        {
            "id": "gap_func",
            "optional": true, "advanced": false, "allow_multiple": false,
            "default_values": ["min"], "field_type": "dropdown",
            "dropdown_options": {"options": [
                {"value": "min", "display": "min"},
                {"value": "max", "display": "max"},
                {"value": "mean", "display": "mean"}
            ]}
        },
        {
            "id": "aligner",
            "optional": true, "advanced": false, "allow_multiple": false,
            "default_values": ["minimap2"], "field_type": "dropdown",
            "dropdown_options": {"options": [
                {"value": "minimap2", "display": "minimap2"},
                {"value": "nucmer", "display": "nucmer"}
            ]}
        },
        {
            "id": "min_edge_weight",
            "optional": true, "advanced": true, "allow_multiple": false,
            "default_values": ["0"], "field_type": "text",
            "text_options": {"validate_as": "float", "min_float": 0}
        },
        {
            "id": "threads",
            "optional": true, "advanced": true, "allow_multiple": false,
            "default_values": ["4"], "field_type": "text",
            "text_options": {"validate_as": "int", "min_int": 1}
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "kb_ragtag",
            "method": "run_ragtag_merge",
            "input_mapping": [
                {"narrative_system_variable": "workspace", "target_property": "workspace_name"},
                {"input_parameter": "query_assembly_ref", "target_property": "query_assembly_ref", "target_type_transform": "resolved-ref"},
                {"input_parameter": "reference_assembly_refs", "target_property": "reference_assembly_refs", "target_type_transform": "list<resolved-ref>"},
                {"input_parameter": "output_assembly_name", "target_property": "output_assembly_name"},
                {"input_parameter": "gap_func", "target_property": "gap_func"},
                {"input_parameter": "aligner", "target_property": "aligner"},
                {"input_parameter": "min_edge_weight", "target_property": "min_edge_weight"},
                {"input_parameter": "threads", "target_property": "threads"}
            ],
            "output_mapping": [
                {"narrative_system_variable": "workspace", "target_property": "ws"},
                {"service_method_output_path": [0, "report_name"], "target_property": "report_name"},
                {"service_method_output_path": [0, "report_ref"], "target_property": "report_ref"}
            ]
        }
    },
    "job_id_output_field": "docker"
}
